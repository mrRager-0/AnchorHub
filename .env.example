# Database
DATABASE_URL=postgresql://user:password@localhost:5432/anchorhub

# Redis
REDIS_URL=redis://localhost:6379

# Stellar
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Auth
API_KEY_SALT=change-me-min-32-chars-long-salt-here
JWT_SECRET=change-me-jwt-secret

# Webhooks
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# Server
PORT=3000
LOG_LEVEL=info

# Workers
ANCHOR_POLL_INTERVAL_MS=30000
HEALTH_CHECK_INTERVAL_MS=60000
