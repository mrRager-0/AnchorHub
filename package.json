{
  "name": "anchorhub",
  "version": "0.1.0",
  "description": "Unified Anchor Aggregator API for Stellar",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "workers": "ts-node-dev --respawn src/workers/index.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/db/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.14.0",
    "@stellar/stellar-sdk": "12.1.0",
    "argon2": "0.40.3",
    "bullmq": "5.7.8",
    "fastify": "4.27.0",
    "@fastify/jwt": "8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "ioredis": "5.3.2",
    "pino": "9.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "20.12.12",
    "@typescript-eslint/eslint-plugin": "7.10.0",
    "@typescript-eslint/parser": "7.10.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "prisma": "5.14.0",
    "ts-jest": "29.1.4",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=9.x"
  }
}
